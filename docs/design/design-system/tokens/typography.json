{
  "typography": {
    "fontFamily": {
      "base": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    "title": {
      "fontSize": "22px",
      "lineHeight": 1.2,
      "fontWeight": 600
    },
    "subtitle": {
      "fontSize": "18px",
      "lineHeight": 1.3,
      "fontWeight": 600
    },
    "body": {
      "fontSize": "16px",
      "lineHeight": 1.5,
      "fontWeight": 400
    },
    "bodySmall": {
      "fontSize": "14px",
      "lineHeight": 1.45,
      "fontWeight": 400,
      "color": "text.secondary"
    },
    "caption": {
      "fontSize": "12px",
      "lineHeight": 1.35,
      "fontWeight": 500,
      "color": "text.muted"
    },
    "overline": {
      "fontSize": "12px",
      "lineHeight": 1.2,
      "fontWeight": 600,
      "letterSpacing": "0.04em",
      "textTransform": "uppercase",
      "color": "text.muted"
    },
    "amount": {
      "fontWeight": 600,
      "fontVariantNumeric": "tabular-nums"
    },
    "wit": {
      "fontSize": "15px",
      "lineHeight": 1.45,
      "fontStyle": "italic",
      "color": "text.secondary"
    },
    "display": {
      "fontSize": "32px",
      "lineHeight": 1.1,
      "fontWeight": 700,
      "use": "time-jump screen only"
    }
  }
}
